{
    "name": "meal-planner-frontend-admin",
    "version": "0.0.119",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json --noEmit --incremental false && vite build && node scripts/check-production-artifact.mjs",
        "start": "vite preview",
        "build:mocks": "node scripts/build-tests.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
        "test": "npm run build:mocks && node scripts/test.mjs",
        "lint": "eslint . && prettier --check . && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "format": "prettier --write .",
        "contracts:generate": "node scripts/generate-contracts.mjs",
        "contracts:check": "node scripts/generate-contracts.mjs --check",
        "architecture:check": "node scripts/check-architecture.mjs",
        "check": "npm --workspace design-system run check && npm run check:app",
        "preview": "vite preview",
        "check:app": "npm run contracts:check && npm run architecture:check && npm run typecheck && npm run lint && npm test",
        "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
        "test:browser": "node scripts/admin-browser-smoke.mjs",
        "test:performance:budget": "npm run build && node scripts/check-browser-budget.mjs"
    },
    "dependencies": {
        "@meal-planner/design-system": "file:./design-system",
        "@tanstack/react-query": "5.103.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "7.18.3",
        "zod": "4.6.7",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "10.11.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "globals": "17.12.0",
        "msw": "2.15.0",
        "otplib": "13.5.0",
        "prettier": "3.9.9",
        "stylelint": "17.15.0",
        "stylelint-config-standard": "40.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.2.4"
    },
    "workspaces": [
        "design-system"
    ]
}
