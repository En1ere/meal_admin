# Optional override: development defaults to mock; builds and preview default to real.
# All builds, including --mode development, reject mock mode.
# VITE_API_MODE=mock
# Development real mode proxies /api to the local backend.
BACKEND_ORIGIN=http://127.0.0.1:3001
# Production static hosting must proxy /api at the web server.
# Never put an access key into VITE_* variables: these values reach the browser.
# Optional public SemVer release label.
# VITE_APP_VERSION=0.0.0
