{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
